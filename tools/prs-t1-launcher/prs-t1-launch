#!/system/bin/sh

AGENT=/data/local/tmp/prs-t1-agent
LOG=/data/local/tmp/prs-t1-native-launch.log

# Keep the root session independent of the Activity's pipes. The agent creates
# a new session before stopping zygote; a shell background job is not enough on
# this device because the APK inherits zygote's process group.
exec </dev/null >> "$LOG" 2>&1

# This old Android shell does not provide the `[`/`test` command. Executing
# the agent's read-only help path is both an existence/executable check and a
# useful preflight before stopping the Android framework.
if "$AGENT" help >/dev/null 2>&1; then
    :
else
    echo "native agent is missing or not executable: $AGENT"
    exit 1
fi

trap "" HUP
echo "su handoff started"
exec "$AGENT" launch-standalone /dev/graphics/fb0 standby
